<Project>
  <PropertyGroup>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- La CI pone la versión de la etiqueta: dotnet publish -p:Version=1.2.3 -->
    <Version>0.0.0</Version>
    <Authors>Alejandro</Authors>
    <Product>Worknotch</Product>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Permite compilar la app de Windows también desde Linux (no ejecutarla) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
