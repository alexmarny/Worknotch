<Window x:Class="Worknotch.App.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Worknotch.App.Controles"
        Title="Worknotch"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        Width="1320" Height="520" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource Letra}" FontSize="14">

  <Window.Resources>
    <!-- Un dato de la fila: hora del aviso, proyecto, pasos… -->
    <DataTemplate x:Key="Dato">
      <TextBlock x:Name="T" Text="{Binding Text}" Style="{StaticResource TextoSuave}" Margin="0,2,10,0" />
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="Accent">
          <Setter TargetName="T" Property="Foreground" Value="{DynamicResource wn-ambar}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Alert">
          <Setter TargetName="T" Property="Foreground" Value="{DynamicResource wn-alta}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="FilaTarea">
      <Border x:Name="Fila" CornerRadius="8" Padding="4,5,0,5" Background="Transparent" Tag="{Binding Id}" MouseRightButtonUp="TaskRow_RightClick">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border x:Name="Barra" Width="3" CornerRadius="1.5" Margin="0,1,6,1" Background="Transparent" />
          <CheckBox Grid.Column="1" Style="{StaticResource Casilla}" VerticalAlignment="Top" Margin="0,1,8,0"
                    IsChecked="{Binding Done, Mode=OneWay}" IsEnabled="{Binding CanEdit}" Tag="{Binding Id}" Click="TaskCheck_Click"
                    AutomationProperties.Name="{Binding CheckName}" />
          <Button Grid.Column="2" Style="{StaticResource BotonFila}" Tag="{Binding Id}" Click="TaskOpen_Click" AutomationProperties.Name="{Binding Title}">
            <StackPanel>
              <TextBlock x:Name="Titulo" Text="{Binding Title}" Style="{StaticResource Texto}" TextWrapping="Wrap" TextTrimming="None" />
              <ItemsControl ItemsSource="{Binding Facts}" ItemTemplate="{StaticResource Dato}" Focusable="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </StackPanel>
          </Button>
          <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" Margin="4,-3,0,0">
            <Button x:Name="Centrar" Style="{StaticResource BotonIcono}" Tag="{Binding Id}" Click="TaskFocus_Click" ToolTip="Centrarte en esta tarea" AutomationProperties.Name="Centrarte en esta tarea">
              <Path Style="{StaticResource Icono}" Data="M5.5,3.5 L12,8 L5.5,12.5 Z" />
            </Button>
            <Button x:Name="Mas" Style="{StaticResource BotonIcono}" Tag="{Binding Id}" Click="TaskMenu_Click" ToolTip="Más opciones" AutomationProperties.Name="Más opciones">
              <Path Style="{StaticResource Icono}" StrokeThickness="2.4" Data="M3.5,8 h0.01 M8,8 h0.01 M12.5,8 h0.01" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="Fila" Property="IsMouseOver" Value="True">
          <Setter TargetName="Fila" Property="Background" Value="{DynamicResource wn-relieve}" />
        </Trigger>
        <DataTrigger Binding="{Binding Priority}" Value="High">
          <Setter TargetName="Barra" Property="Background" Value="{DynamicResource wn-alta}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Priority}" Value="Medium">
          <Setter TargetName="Barra" Property="Background" Value="{DynamicResource wn-media}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Priority}" Value="Low">
          <Setter TargetName="Barra" Property="Background" Value="{DynamicResource wn-filete}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Done}" Value="True">
          <Setter TargetName="Titulo" Property="Foreground" Value="{DynamicResource wn-texto-suave}" />
          <Setter TargetName="Titulo" Property="TextDecorations" Value="Strikethrough" />
          <Setter TargetName="Centrar" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding CanEdit}" Value="False">
          <Setter TargetName="Centrar" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="Mas" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding InFocus}" Value="True">
          <Setter TargetName="Titulo" Property="Foreground" Value="{DynamicResource wn-ambar}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="FilaPaso">
      <Grid Margin="0,2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <CheckBox Style="{StaticResource Casilla}" IsChecked="{Binding Done, Mode=OneWay}" Tag="{Binding Index}" Click="StepCheck_Click" Margin="0,0,8,0" AutomationProperties.Name="{Binding Title}" />
        <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource Texto}" TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center" />
        <Button Grid.Column="2" Style="{StaticResource BotonIcono}" Tag="{Binding Index}" Click="StepRemove_Click" ToolTip="Quitar este paso" AutomationProperties.Name="Quitar este paso">
          <Path Style="{StaticResource Icono}" Data="M4.5,4.5 L11.5,11.5 M11.5,4.5 L4.5,11.5" />
        </Button>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="FilaRecorte">
      <Border x:Name="Fila" CornerRadius="8" Background="{DynamicResource wn-relieve}" Margin="0,0,0,6">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button Style="{StaticResource BotonFila}" Padding="8,6" Tag="{Binding Id}" Click="Clip_Click" MouseDoubleClick="Clip_DoubleClick"
                  PreviewMouseMove="Clip_MouseMove" AutomationProperties.Name="{Binding Title}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border x:Name="Miniatura" Width="40" Height="40" CornerRadius="6" Margin="0,0,8,0" Visibility="Collapsed" ClipToBounds="True">
                <Border.Background>
                  <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill" />
                </Border.Background>
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" Style="{StaticResource Texto}" FontSize="12" MaxHeight="34" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Sub}" Style="{StaticResource TextoSuave}" />
              </StackPanel>
            </Grid>
          </Button>
          <Button Grid.Column="1" Style="{StaticResource BotonIcono}" VerticalAlignment="Top" Tag="{Binding Id}" Click="ClipRemove_Click" ToolTip="Descolgar" AutomationProperties.Name="Descolgar">
            <Path Style="{StaticResource Icono}" Data="M4.5,4.5 L11.5,11.5 M11.5,4.5 L4.5,11.5" />
          </Button>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding HasThumb}" Value="True">
          <Setter TargetName="Miniatura" Property="Visibility" Value="Visible" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Un día de la semana: tareas hechas y minutos de foco -->
    <DataTemplate x:Key="ColumnaDia">
      <Grid Width="30" Margin="0,0,4,0" ToolTip="{Binding Tip}">
        <Grid.RowDefinitions>
          <RowDefinition Height="84" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
          <Border Width="9" Height="{Binding TasksHeight}" CornerRadius="3,3,0,0" Background="{DynamicResource wn-hecho}" VerticalAlignment="Bottom" Margin="0,0,3,0" />
          <Border Width="9" Height="{Binding FocusHeight}" CornerRadius="3,3,0,0" Background="{DynamicResource wn-ambar}" VerticalAlignment="Bottom" />
        </StackPanel>
        <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource wn-filete}" />
        <TextBlock x:Name="Letra" Grid.Row="1" Text="{Binding Label}" Style="{StaticResource TextoSuave}" HorizontalAlignment="Center" Margin="0,4,0,0" />
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsToday}" Value="True">
          <Setter TargetName="Letra" Property="Foreground" Value="{DynamicResource wn-texto}" />
          <Setter TargetName="Letra" Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <!-- El notch: negro en Noche, sale del borde de arriba. Solo él cambia de tamaño. -->
    <Border x:Name="Shell" HorizontalAlignment="Center" VerticalAlignment="Top" Width="240" Height="30"
            Background="{DynamicResource wn-notch}" BorderBrush="{DynamicResource wn-filete}" BorderThickness="1,0,1,1"
            CornerRadius="0,0,18,18" ClipToBounds="True" MouseEnter="Shell_MouseEnter" MouseLeave="Shell_MouseLeave"
            AllowDrop="True" DragEnter="Shell_DragEnter">
      <Grid>

        <!-- Pastilla: lo siguiente del día, o el temporizador en marcha -->
        <Button x:Name="Pill" Style="{StaticResource BotonFila}" Height="29" VerticalAlignment="Top" Click="Pill_Click" AutomationProperties.Name="Abrir Worknotch">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <c:DotDisplay x:Name="PillClock" Dot="2" Gap="1" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed"
                          OnBrush="{DynamicResource wn-ambar}" />
            <TextBlock x:Name="PillText" Style="{StaticResource Texto}" FontSize="12" MaxWidth="170" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <!-- Aviso: un recordatorio o el final del foco -->
        <Grid x:Name="Alert" Width="456" Height="112" VerticalAlignment="Top" HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,2,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock x:Name="AlertTitle" Style="{StaticResource Texto}" FontWeight="SemiBold" Margin="18,12,18,0" />
          <TextBlock x:Name="AlertText" Grid.Row="1" Style="{StaticResource TextoSuave}" Margin="18,2,18,0" TextWrapping="Wrap" MaxHeight="34" />
          <StackPanel x:Name="AlertButtons" Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="18,0,18,14" />
        </Grid>

        <!-- Panel -->
        <Grid x:Name="PanelView" Width="1000" Height="428" VerticalAlignment="Top" HorizontalAlignment="Center" Visibility="Collapsed" Opacity="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- Días -->
          <Grid Margin="14,0,8,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="Days" Orientation="Horizontal" VerticalAlignment="Center">
              <RadioButton x:Name="InboxChip" Style="{StaticResource Ficha}" GroupName="dias" Click="Inbox_Click" Content="Bandeja" Margin="0,0,10,0" />
              <Button x:Name="PrevDay" Style="{StaticResource BotonIcono}" Click="PrevDay_Click" ToolTip="Día anterior" AutomationProperties.Name="Día anterior" Margin="0,0,6,0">
                <Path Style="{StaticResource Icono}" Data="M10,3.5 L5.5,8 L10,12.5" />
              </Button>
              <StackPanel x:Name="DayStrip" Orientation="Horizontal" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="UpdateButton" Style="{StaticResource BotonPrincipal}" Click="Update_Click" Visibility="Collapsed" Margin="0,0,8,0" />
              <Button x:Name="UndoButton" Style="{StaticResource BotonIcono}" Click="Undo_Click" ToolTip="Deshacer (Ctrl+Z)" AutomationProperties.Name="Deshacer" IsEnabled="False">
                <Path Style="{StaticResource Icono}" Data="M6,3.5 L2.5,7 L6,10.5 M2.5,7 H10 A3.25,3.25 0 0 1 10,13.5 H7.5" />
              </Button>
              <Button x:Name="SettingsButton" Style="{StaticResource BotonIcono}" Click="Settings_Click" ToolTip="Ajustes" AutomationProperties.Name="Ajustes">
                <Path Style="{StaticResource Icono}" Data="M2,4.5 H8.5 M12.5,4.5 H14 M2,11.5 H3.5 M7.5,11.5 H14 M8.5,4.5 A2,2 0 1 0 12.5,4.5 A2,2 0 1 0 8.5,4.5 M3.5,11.5 A2,2 0 1 0 7.5,11.5 A2,2 0 1 0 3.5,11.5" />
              </Button>
            </StackPanel>
          </Grid>

          <!-- Tarjetas -->
          <ScrollViewer x:Name="CardsScroll" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False" Margin="14,0,4,14">
            <StackPanel x:Name="Cards" Orientation="Horizontal">

              <!-- Tareas -->
              <Border x:Name="CardTasks" Style="{StaticResource Tarjeta}" Width="372">
                <Grid>
                  <Grid x:Name="TaskListView">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock x:Name="DayTitle" Style="{StaticResource Texto}" FontFamily="{StaticResource LetraTitulo}" FontSize="18" FontWeight="SemiBold" />
                      <TextBlock x:Name="DayCount" Grid.Column="1" Style="{StaticResource TextoSuave}" VerticalAlignment="Bottom" Margin="8,0,0,2" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                      <StackPanel>
                        <TextBlock x:Name="TasksEmpty" Style="{StaticResource TextoSuave}" FontSize="14" TextWrapping="Wrap" Margin="2,6,0,0" Visibility="Collapsed" />
                        <ItemsControl x:Name="TaskList" ItemTemplate="{StaticResource FilaTarea}" Focusable="False" />
                      </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                      <TextBlock x:Name="AddError" Style="{StaticResource TextoSuave}" Foreground="{DynamicResource wn-alta}" TextWrapping="Wrap" Margin="2,0,0,6" Visibility="Collapsed" />
                      <TextBox x:Name="AddBox" Style="{StaticResource Campo}" Tag="Añadir tarea…" KeyDown="AddBox_KeyDown" MaxLength="300"
                               ToolTip="Puedes escribir el día, la hora, !alta o #proyecto: «Llamar a Marta mañana 17:30 !alta #Casa»" AutomationProperties.Name="Añadir tarea" />
                    </StackPanel>
                  </Grid>

                  <!-- Detalle de una tarea -->
                  <Grid x:Name="Detail" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                      <Button Style="{StaticResource Boton}" HorizontalAlignment="Left" Click="DetailBack_Click">
                        <StackPanel Orientation="Horizontal">
                          <Path Style="{StaticResource Icono}" Data="M10,3.5 L5.5,8 L10,12.5" Margin="-4,0,2,0" />
                          <TextBlock Text="Volver" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <Button x:Name="DetailRemove" Style="{StaticResource Boton}" HorizontalAlignment="Right" Click="DetailRemove_Click" Content="Quitar tarea" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                      <StackPanel Margin="0,0,8,0">
                        <TextBox x:Name="DetailTitle" Style="{StaticResource Campo}" Tag="Título…" LostFocus="DetailField_Changed" KeyDown="DetailField_KeyDown" MaxLength="300" AutomationProperties.Name="Título" />
                        <TextBlock x:Name="DetailError" Style="{StaticResource TextoSuave}" Foreground="{DynamicResource wn-alta}" TextWrapping="Wrap" Margin="2,6,0,0" Visibility="Collapsed" />
                        <Grid Margin="0,10,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="38" />
                            <RowDefinition Height="38" />
                            <RowDefinition Height="38" />
                            <RowDefinition Height="38" />
                            <RowDefinition Height="38" />
                            <RowDefinition Height="38" />
                            <RowDefinition Height="38" />
                          </Grid.RowDefinitions>
                          <TextBlock Text="Día" Style="{StaticResource TextoSuave}" VerticalAlignment="Center" />
                          <Button x:Name="DetailDay" Grid.Column="1" Style="{StaticResource Boton}" HorizontalAlignment="Left" Click="DetailDay_Click" />
                          <TextBlock Grid.Row="1" Text="Aviso" Style="{StaticResource TextoSuave}" VerticalAlignment="Center" />
                          <TextBox x:Name="DetailRemind" Grid.Row="1" Grid.Column="1" Style="{StaticResource Campo}" Tag="17:30…" VerticalAlignment="Center" LostFocus="DetailField_Changed" KeyDown="DetailField_KeyDown" AutomationProperties.Name="Hora del aviso" />
                          <TextBlock Grid.Row="2" Text="Prioridad" Style="{StaticResource TextoSuave}" VerticalAlignment="Center" />
                          <Button x:Name="DetailPriority" Grid.Row="2" Grid.Column="1" Style="{StaticResource Boton}" HorizontalAlignment="Left" Click="DetailPriority_Click" ToolTip="Pulsa para cambiarla" />
                          <TextBlock Grid.Row="3" Text="Se repite" Style="{StaticResource TextoSuave}" VerticalAlignment="Center" />
                          <Button x:Name="DetailRepeat" Grid.Row="3" Grid.Column="1" Style="{StaticResource Boton}" HorizontalAlignment="Left" Click="DetailRepeat_Click" ToolTip="Pulsa para cambiarlo" />
                          <TextBlock Grid.Row="4" Text="Proyecto" Style="{StaticResource TextoSuave}" VerticalAlignment="Center" />
                          <TextBox x:Name="DetailProject" Grid.Row="4" Grid.Column="1" Style="{StaticResource Campo}" Tag="Sin proyecto…" VerticalAlignment="Center" LostFocus="DetailField_Changed" KeyDown="DetailField_KeyDown" MaxLength="40" AutomationProperties.Name="Proyecto" />
                          <TextBlock Grid.Row="5" Text="Minutos de foco" Style="{StaticResource TextoSuave}" VerticalAlignment="Center" />
                          <TextBox x:Name="DetailMinutes" Grid.Row="5" Grid.Column="1" Style="{StaticResource Campo}" Tag="Los de siempre…" VerticalAlignment="Center" LostFocus="DetailField_Changed" KeyDown="DetailField_KeyDown" MaxLength="3" AutomationProperties.Name="Minutos de foco" />
                          <TextBlock Grid.Row="6" Text="Fecha límite" Style="{StaticResource TextoSuave}" VerticalAlignment="Center" />
                          <TextBox x:Name="DetailDeadline" Grid.Row="6" Grid.Column="1" Style="{StaticResource Campo}" Tag="viernes, 20/11…" VerticalAlignment="Center" LostFocus="DetailField_Changed" KeyDown="DetailField_KeyDown" AutomationProperties.Name="Fecha límite" />
                        </Grid>
                        <TextBlock Text="Pasos" Style="{StaticResource TextoSuave}" Margin="0,10,0,4" />
                        <ItemsControl x:Name="DetailSteps" ItemTemplate="{StaticResource FilaPaso}" Focusable="False" />
                        <TextBox x:Name="DetailStepBox" Style="{StaticResource Campo}" Tag="Añadir paso…" KeyDown="StepBox_KeyDown" Margin="0,4,0,0" MaxLength="200" AutomationProperties.Name="Añadir paso" />
                        <TextBlock Text="Notas" Style="{StaticResource TextoSuave}" Margin="0,12,0,4" />
                        <TextBox x:Name="DetailNotes" Style="{StaticResource Campo}" Tag="Lo que haga falta recordar…" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" VerticalContentAlignment="Top"
                                 LostFocus="DetailField_Changed" AutomationProperties.Name="Notas de la tarea" />
                        <TextBlock x:Name="DetailInfo" Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,10,0,0" />
                      </StackPanel>
                    </ScrollViewer>
                  </Grid>
                </Grid>
              </Border>

              <!-- Foco -->
              <Border x:Name="CardFocus" Style="{StaticResource Tarjeta}" Width="264">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid Margin="0,0,0,10">
                    <TextBlock Text="Foco" Style="{StaticResource TituloTarjeta}" />
                    <TextBlock x:Name="FocusToday" Style="{StaticResource TextoSuave}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                  </Grid>
                  <Border Grid.Row="1" Background="{DynamicResource wn-pantalla}" CornerRadius="10" Height="92">
                    <c:DotDisplay x:Name="Clock" Dot="6" Gap="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  OnBrush="{DynamicResource wn-led}" OffBrush="{DynamicResource wn-led-apagado}" />
                  </Border>
                  <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <TextBlock x:Name="FocusTask" Style="{StaticResource Texto}" TextWrapping="Wrap" MaxHeight="40" />
                    <TextBlock x:Name="FocusHint" Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,2,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Row="3">
                    <!-- Parado: elegir duración y modo -->
                    <StackPanel x:Name="FocusIdle">
                      <StackPanel x:Name="FocusLength" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Style="{StaticResource Boton}" Click="FocusLess_Click" ToolTip="Cinco minutos menos" AutomationProperties.Name="Cinco minutos menos">
                          <Path Style="{StaticResource Icono}" Data="M4,8 H12" />
                        </Button>
                        <TextBlock x:Name="FocusMinutes" Style="{StaticResource Texto}" Width="64" TextAlignment="Center" VerticalAlignment="Center" />
                        <Button Style="{StaticResource Boton}" Click="FocusMore_Click" ToolTip="Cinco minutos más" AutomationProperties.Name="Cinco minutos más">
                          <Path Style="{StaticResource Icono}" Data="M8,4 V12 M4,8 H12" />
                        </Button>
                      </StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="FocusStart" Style="{StaticResource BotonPrincipal}" Click="FocusStart_Click" Content="Empezar" />
                        <Button x:Name="FocusMode" Grid.Column="1" Style="{StaticResource Boton}" Click="FocusMode_Click" HorizontalAlignment="Right" ToolTip="Cambia entre cuenta atrás y cronómetro" />
                      </Grid>
                    </StackPanel>
                    <!-- En marcha o en pausa -->
                    <WrapPanel x:Name="FocusActive" Visibility="Collapsed">
                      <Button x:Name="FocusPause" Style="{StaticResource BotonPrincipal}" Click="FocusPause_Click" Margin="0,6,6,0" />
                      <Button x:Name="FocusDone" Style="{StaticResource Boton}" Click="FocusDone_Click" Content="Hecha" Margin="0,6,6,0" />
                      <Button x:Name="FocusPlus" Style="{StaticResource Boton}" Click="FocusPlus_Click" Content="5 min más" Margin="0,6,6,0" />
                      <Button Style="{StaticResource Boton}" Click="FocusStop_Click" Content="Parar" Margin="0,6,0,0" />
                    </WrapPanel>
                  </StackPanel>
                </Grid>
              </Border>

              <!-- Notas -->
              <Border x:Name="CardNotes" Style="{StaticResource Tarjeta}" Width="250">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="Notas" Style="{StaticResource TituloTarjeta}" Margin="0,0,0,10" />
                  <TextBox x:Name="Notes" Grid.Row="1" Style="{StaticResource Campo}" Tag="Escribe algo…" AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap"
                           VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" TextChanged="Notes_TextChanged" LostFocus="Notes_LostFocus" AutomationProperties.Name="Bloc de notas" />
                </Grid>
              </Border>

              <!-- Recortes -->
              <Border x:Name="CardClips" Style="{StaticResource Tarjeta}" Width="250" AllowDrop="True" Drop="Clips_Drop" DragOver="Clips_DragOver">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="Recortes" Style="{StaticResource TituloTarjeta}" Margin="0,0,0,10" />
                  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel>
                      <TextBlock x:Name="ClipsEmpty" Style="{StaticResource TextoSuave}" FontSize="14" TextWrapping="Wrap" />
                      <TextBlock x:Name="ClipsHint" Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,0,0,8" Text="Pulsa uno para copiarlo. Con doble clic se abre." />
                      <ItemsControl x:Name="ClipList" ItemTemplate="{StaticResource FilaRecorte}" Focusable="False" />
                    </StackPanel>
                  </ScrollViewer>
                </Grid>
              </Border>

              <!-- Semana -->
              <Border x:Name="CardWeek" Style="{StaticResource Tarjeta}" Width="270">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="Semana" Style="{StaticResource TituloTarjeta}" Margin="0,0,0,10" />
                  <ItemsControl x:Name="WeekChart" Grid.Row="1" ItemTemplate="{StaticResource ColumnaDia}" Focusable="False" HorizontalAlignment="Left">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                  <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <Border Width="9" Height="9" CornerRadius="2" Background="{DynamicResource wn-hecho}" VerticalAlignment="Center" />
                    <TextBlock Text="Tareas hechas" Style="{StaticResource TextoSuave}" Margin="6,0,14,0" />
                    <Border Width="9" Height="9" CornerRadius="2" Background="{DynamicResource wn-ambar}" VerticalAlignment="Center" />
                    <TextBlock Text="Foco" Style="{StaticResource TextoSuave}" Margin="6,0,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Row="3" VerticalAlignment="Bottom">
                    <TextBlock x:Name="WeekSentence" Style="{StaticResource Texto}" TextWrapping="Wrap" TextTrimming="None" />
                    <TextBlock x:Name="WeekStreak" Style="{StaticResource TextoSuave}" Margin="0,8,0,0" />
                    <TextBlock x:Name="WeekPeak" Style="{StaticResource TextoSuave}" Margin="0,2,0,0" />
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- Ajustes -->
          <Border x:Name="SettingsView" Grid.Row="1" Style="{StaticResource Tarjeta}" Margin="14,0,14,14" Visibility="Collapsed">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid Margin="0,0,0,8">
                <TextBlock Text="Ajustes" Style="{StaticResource Texto}" FontFamily="{StaticResource LetraTitulo}" FontSize="18" FontWeight="SemiBold" />
                <Button Style="{StaticResource Boton}" HorizontalAlignment="Right" Click="Settings_Click" Content="Volver a las tarjetas" />
              </Grid>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                <Grid Margin="0,0,10,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <StackPanel>
                    <TextBlock Text="Tema" Style="{StaticResource TextoSuave}" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                      <RadioButton x:Name="ThemeSystem" Style="{StaticResource Ficha}" GroupName="tema" Content="El de Windows" Click="Theme_Click" Tag="System" />
                      <RadioButton x:Name="ThemeNight" Style="{StaticResource Ficha}" GroupName="tema" Content="Noche" Click="Theme_Click" Tag="Night" />
                      <RadioButton x:Name="ThemeDay" Style="{StaticResource Ficha}" GroupName="tema" Content="Día" Click="Theme_Click" Tag="Day" />
                    </StackPanel>
                    <TextBlock Text="Pantalla" Style="{StaticResource TextoSuave}" Margin="0,14,0,6" />
                    <StackPanel Orientation="Horizontal">
                      <RadioButton x:Name="ScreenPointer" Style="{StaticResource Ficha}" GroupName="pantalla" Content="Donde esté el puntero" Click="Screen_Click" Tag="Pointer" />
                      <RadioButton x:Name="ScreenPrimary" Style="{StaticResource Ficha}" GroupName="pantalla" Content="La principal" Click="Screen_Click" Tag="Primary" />
                    </StackPanel>
                    <TextBlock Text="Atajo para abrir y cerrar" Style="{StaticResource TextoSuave}" Margin="0,14,0,6" />
                    <Button x:Name="HotkeyButton" Style="{StaticResource Boton}" HorizontalAlignment="Left" Click="Hotkey_Click" ToolTip="Pulsa para elegir otro" />
                    <TextBlock x:Name="HotkeyError" Style="{StaticResource TextoSuave}" Foreground="{DynamicResource wn-alta}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"
                               Text="Ese atajo ya lo usa otro programa. Pulsa el botón para elegir otro." />
                    <TextBlock Text="Duración del foco" Style="{StaticResource TextoSuave}" Margin="0,14,0,6" />
                    <StackPanel Orientation="Horizontal">
                      <Button Style="{StaticResource Boton}" Click="FocusLess_Click" AutomationProperties.Name="Cinco minutos menos">
                        <Path Style="{StaticResource Icono}" Data="M4,8 H12" />
                      </Button>
                      <TextBlock x:Name="SettingsMinutes" Style="{StaticResource Texto}" Width="64" TextAlignment="Center" VerticalAlignment="Center" />
                      <Button Style="{StaticResource Boton}" Click="FocusMore_Click" AutomationProperties.Name="Cinco minutos más">
                        <Path Style="{StaticResource Icono}" Data="M8,4 V12 M4,8 H12" />
                      </Button>
                    </StackPanel>
                  </StackPanel>

                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Tarjetas a la vista" Style="{StaticResource TextoSuave}" Margin="0,0,0,2" />
                    <CheckBox x:Name="ShowTasks" Style="{StaticResource Interruptor}" Content="Tareas" Tag="tareas" Click="Card_Click" />
                    <CheckBox x:Name="ShowFocus" Style="{StaticResource Interruptor}" Content="Foco" Tag="foco" Click="Card_Click" />
                    <CheckBox x:Name="ShowNotes" Style="{StaticResource Interruptor}" Content="Notas" Tag="notas" Click="Card_Click" />
                    <CheckBox x:Name="ShowClips" Style="{StaticResource Interruptor}" Content="Recortes" Tag="recortes" Click="Card_Click" />
                    <CheckBox x:Name="ShowWeek" Style="{StaticResource Interruptor}" Content="Semana" Tag="semana" Click="Card_Click" />
                    <TextBlock Text="Recortes" Style="{StaticResource TextoSuave}" Margin="0,12,0,2" />
                    <CheckBox x:Name="OptClipboard" Style="{StaticResource Interruptor}" Content="Colgar lo que copias" Click="Option_Click" />
                    <CheckBox x:Name="OptScreenshots" Style="{StaticResource Interruptor}" Content="Colgar las capturas de pantalla" Click="Option_Click" />
                  </StackPanel>

                  <StackPanel Grid.Column="4">
                    <TextBlock Text="Comportamiento" Style="{StaticResource TextoSuave}" Margin="0,0,0,2" />
                    <CheckBox x:Name="OptAutostart" Style="{StaticResource Interruptor}" Content="Abrir al iniciar Windows" Click="Option_Click" />
                    <CheckBox x:Name="OptSound" Style="{StaticResource Interruptor}" Content="Sonido en los avisos" Click="Option_Click" />
                    <CheckBox x:Name="OptCarry" Style="{StaticResource Interruptor}" Content="Traer a hoy lo que quedó sin hacer" Click="Option_Click" />
                    <CheckBox x:Name="OptWeekends" Style="{StaticResource Interruptor}" Content="Contar los fines de semana en la racha" Click="Option_Click" />
                    <CheckBox x:Name="OptUpdates" Style="{StaticResource Interruptor}" Content="Buscar versiones nuevas al abrir" Click="Option_Click" />
                    <TextBlock Text="Claude" Style="{StaticResource TextoSuave}" Margin="0,12,0,6" />
                    <Button x:Name="ClaudeButton" Style="{StaticResource Boton}" HorizontalAlignment="Left" Click="Claude_Click" Content="Copiar la orden para conectar Claude"
                            ToolTip="Pégala en una terminal. Después, Claude puede planificar, completar y cronometrar tus tareas." />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                      <Button Style="{StaticResource Boton}" Click="DataFolder_Click" Content="Abrir la carpeta de datos" Margin="0,0,6,0" />
                      <Button Style="{StaticResource Boton}" Click="Quit_Click" Content="Salir" />
                    </StackPanel>
                    <TextBlock x:Name="VersionText" Style="{StaticResource TextoSuave}" Margin="0,10,0,0" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
